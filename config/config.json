{
    # Lines starting with '#' are comments and are stripped before JSON parsing.
    # This file only illustrates the keys: it is not strict JSON, your
    # loader must support this comment style (see config_loader.py).

    "highscore_filename": "highscore.json",

    # One entry per level. If the array is shorter than the number of
    # levels required (>= 10), missing levels reuse the last entry
    # with a randomly generated maze (see spec 6.1 / 5.4).
    "levels": [
        { "width": 10, "height": 10 }
    ],

    "lives": 3,
    "pacgum": 42,
    "points_per_pacgum": 10,
    "points_per_super_pacgum": 50,
    "points_per_ghost": 200,
    "seed": 42,
    "level_max_time": 90
}
